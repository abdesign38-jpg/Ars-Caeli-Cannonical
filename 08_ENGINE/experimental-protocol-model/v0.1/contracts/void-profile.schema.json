{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/void-profile.schema.json",
  "title": "VOID_PROFILE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "void_profile_id",
    "source_construct",
    "operationalization",
    "schedule",
    "derived_schedule_metrics",
    "entropy_control",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "void_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "label": {
      "type": "string"
    },
    "source_construct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acspec_id",
        "definition",
        "source_status",
        "provenance"
      ],
      "properties": {
        "acspec_id": {
          "const": "ACSPEC-101"
        },
        "definition": {
          "const": "Estructura de baja información utilizada para modular expectativa."
        },
        "source_status": {
          "const": "draft"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/provenance_record"
          }
        }
      }
    },
    "operationalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_dimension",
        "definition",
        "status"
      ],
      "properties": {
        "primary_dimension": {
          "const": "temporal_occupancy"
        },
        "definition": {
          "const": "Proportion and arrangement of active-signal time versus deliberately silent time in a deterministic schedule."
        },
        "status": {
          "const": "experimental_operationalization"
        },
        "not_equivalent_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_duration_s",
        "cycle_duration_s",
        "active_duration_s",
        "silent_duration_s",
        "pattern",
        "seed",
        "cycle_order",
        "cycle_anchor",
        "phase_offset_s"
      ],
      "properties": {
        "block_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cycle_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "active_duration_s": {
          "type": "number",
          "minimum": 0
        },
        "silent_duration_s": {
          "type": "number",
          "minimum": 0
        },
        "pattern": {
          "type": "string",
          "enum": [
            "fixed_periodic",
            "seeded_irregular",
            "explicit_events"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cycle_order": {
          "const": "active_then_silence"
        },
        "cycle_anchor": {
          "const": "condition_start"
        },
        "phase_offset_s": {
          "const": 0
        },
        "explicit_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "onset_s",
              "duration_s"
            ],
            "properties": {
              "onset_s": {
                "type": "number",
                "minimum": 0
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "derived_schedule_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "silence_ratio",
        "event_rate_per_min",
        "mean_gap_ms",
        "gap_cv",
        "temporal_predictability"
      ],
      "properties": {
        "silence_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "event_rate_per_min": {
          "type": "number",
          "minimum": 0
        },
        "mean_gap_ms": {
          "type": "number",
          "minimum": 0
        },
        "gap_cv": {
          "type": "number",
          "minimum": 0
        },
        "temporal_predictability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spectral_occupancy_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "entropy_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "held_constant",
        "rule"
      ],
      "properties": {
        "held_constant": {
          "type": "boolean"
        },
        "rule": {
          "type": "string"
        },
        "entropy_profile_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "const": "experimental_operationalization"
    }
  }
}