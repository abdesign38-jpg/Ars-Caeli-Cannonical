{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/executable-protocol.schema.json",
  "title": "EXECUTABLE_EXPERIMENT_PROTOCOL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_status",
    "compiler_version",
    "protocol_id",
    "source_sha256",
    "primary_outcome",
    "controlled_signal",
    "runtime_policy",
    "probe_set_ref",
    "condition_sequence",
    "condition_fingerprints",
    "integrity"
  ],
  "properties": {
    "execution_status": {
      "const": "validated"
    },
    "compiler_version": {
      "const": "0.1"
    },
    "protocol_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "primary_outcome": {
      "type": "object"
    },
    "controlled_signal": {
      "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/signal_identity"
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "probe_set_ref": {
      "type": "string"
    },
    "condition_sequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "condition_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validation",
        "semantic_validation",
        "reference_validation",
        "conditions_compiled"
      ],
      "properties": {
        "schema_validation": {
          "const": true
        },
        "semantic_validation": {
          "const": true
        },
        "reference_validation": {
          "const": true
        },
        "conditions_compiled": {
          "const": true
        }
      }
    }
  }
}