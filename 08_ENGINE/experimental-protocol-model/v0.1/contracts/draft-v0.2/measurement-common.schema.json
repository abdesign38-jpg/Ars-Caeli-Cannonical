{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ars-caeli.local/contracts/v0.2/measurement-common.schema.json",
  "$defs":{
    "scalar":{"type":["number","string","boolean"]},
    "parameter":{"type":"object","additionalProperties":false,"required":["parameter_id","value"],"properties":{"parameter_id":{"type":"string","minLength":1},"value":{"oneOf":[{"$ref":"#/$defs/scalar"},{"type":"array","items":{"$ref":"#/$defs/scalar"}}]}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["runtime_id","runtime_version","clock_source","input_modality"],"properties":{"runtime_id":{"type":"string"},"runtime_version":{"type":"string"},"clock_source":{"type":"string"},"input_modality":{"type":"string"},"display_context":{"type":["object","null"]}}},
    "timing_trace":{"type":"object","additionalProperties":false,"required":["stimulus_onset_ms","response_ms"],"properties":{"stimulus_onset_ms":{"type":"number","minimum":0},"response_ms":{"type":["number","null"],"minimum":0}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["evidence_role"],"properties":{"evidence_role":{"enum":["experimental_operationalization","engine_measured","participant_reported","behavioral_measured","derived_metric","hypothesis","source_symbolic","source_documented","source_draft"]},"apl_knowledge_layer":{"enum":["universal","individual","symbolic"]}}}
  }
}
