{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/observation-runtime/v0.1/session-state.schema.json",
  "title": "AEON D.1 SESSION_STATE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_state_version",
    "session_id",
    "series_id",
    "participant_id",
    "protocol_id",
    "state",
    "revision",
    "last_event_seq",
    "current_attempt_id",
    "current_runtime_epoch_id",
    "created_at",
    "started_at",
    "finalized_at",
    "interpretation_policy"
  ],
  "properties": {
    "session_state_version": {
      "const": "0.1-draft"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "participant_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "CREATED",
        "READY",
        "ARMED",
        "OBSERVING",
        "RESOLVED",
        "FINALIZED",
        "ABORTED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": -1
    },
    "current_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "current_runtime_epoch_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finalized_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "interpretation_policy": {
      "const": "no_automatic_interpretation"
    }
  }
}
