{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/stimulus-condition.schema.json",
  "title": "STIMULUS_CONDITION",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "condition_id",
    "experimental_question",
    "hypothesis_refs",
    "manipulated_variables",
    "held_constant",
    "signal",
    "void_profile",
    "timing",
    "order_control",
    "blinding",
    "measurement_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "condition_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "label": {
      "type": "string"
    },
    "experimental_question": {
      "type": "string"
    },
    "hypothesis_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wound_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "crystallization_profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manipulated_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "experimental_operationalization"
          }
        }
      }
    },
    "held_constant": {
      "type": "object",
      "additionalProperties": true
    },
    "signal": {
      "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/signal_identity"
    },
    "void_profile": {
      "$ref": "https://ars-caeli.local/contracts/void-profile.schema.json"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure_s",
        "probe_after_s"
      ],
      "properties": {
        "exposure_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "probe_after_s": {
          "type": "number",
          "minimum": 0
        },
        "recovery_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "order_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "sequence_id"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "sequence_id": {
          "type": "string"
        },
        "randomization_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "path_role": {
          "type": "string",
          "enum": [
            "baseline",
            "ascending",
            "peak",
            "descending",
            "recovery",
            "control"
          ]
        }
      }
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_hidden_fields",
        "reveal_rule"
      ],
      "properties": {
        "participant_hidden_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reveal_rule": {
          "type": "string"
        }
      }
    },
    "measurement_boundary": {
      "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/measurement_boundary"
    }
  }
}