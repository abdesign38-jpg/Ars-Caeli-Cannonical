{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL Entity Schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "version",
    "status",
    "layer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(APC|ACP|ACR|ACS|ACE|ACH|ACX|ACO|ACM|ACK|ACSYN|ACORG)-[A-Za-z0-9_-]+$"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "layer": {
      "enum": [
        "universal",
        "individual",
        "symbolic",
        "foundation"
      ]
    },
    "maturity": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "predicate",
          "target"
        ],
        "properties": {
          "predicate": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "breaking_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}