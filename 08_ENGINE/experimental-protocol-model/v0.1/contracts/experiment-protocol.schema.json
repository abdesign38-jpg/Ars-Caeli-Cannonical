{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/experiment-protocol.schema.json",
  "title": "EXPERIMENT_PROTOCOL",
  "description": "Orchestrates validated stimulus conditions. Conditions are referenced by ID; they are not embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "protocol_id",
    "title",
    "status",
    "purpose",
    "source_basis",
    "primary_question",
    "primary_outcome",
    "null_interpretation",
    "crystallization_test",
    "design",
    "controlled_signal",
    "condition_refs",
    "probe_set_ref",
    "analysis_plan",
    "stop_rules",
    "non_goals"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "claim",
          "layer"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "enum": [
              "source_documented",
              "source_symbolic",
              "source_draft",
              "hypothesis"
            ]
          }
        }
      }
    },
    "primary_question": {
      "type": "string",
      "minLength": 1
    },
    "primary_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scale",
        "minimum_practical_difference",
        "threshold_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "minimum_practical_difference": {
          "type": "number",
          "minimum": 0
        },
        "threshold_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "null_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "crystallization_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "metrics",
        "requires_replication"
      ],
      "properties": {
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_replication": {
          "type": "boolean"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sequence",
        "block_duration_s",
        "probe_between_blocks",
        "baseline_probe",
        "immediate_post_probe",
        "recovery_probes_s",
        "recommended_replications_before_interpretation",
        "replication_note"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "block_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "probe_between_blocks": {
          "type": "boolean"
        },
        "baseline_probe": {
          "type": "boolean"
        },
        "immediate_post_probe": {
          "type": "boolean"
        },
        "recovery_probes_s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "recommended_replications_before_interpretation": {
          "type": "integer",
          "minimum": 1
        },
        "replication_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controlled_signal": {
      "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/signal_identity"
    },
    "condition_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "probe_set_ref": {
      "type": "string",
      "minLength": 1
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "across_sessions"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "across_sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}