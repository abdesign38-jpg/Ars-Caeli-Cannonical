{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/crystallization-profile.schema.json",
  "title": "CRYSTALLIZATION_PROFILE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "crystallization_id",
    "name",
    "provenance",
    "source_model",
    "experimental_response_construct",
    "equivalence_forbidden"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "crystallization_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/provenance_record"
      }
    },
    "source_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "dimension_weights",
        "organs",
        "interventions",
        "status"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "numeric_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimension_weights": {
          "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/dimension_weights"
        },
        "organs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "const": "source_symbolic"
        }
      }
    },
    "experimental_response_construct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "definition",
        "metrics",
        "status"
      ],
      "properties": {
        "name": {
          "const": "response_crystallization"
        },
        "definition": {
          "const": "Persistence and path-dependence of an observed response after controlled perturbation."
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "definition",
              "calculation",
              "precondition"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "calculation": {
                "type": "string"
              },
              "precondition": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "const": "experimental_operationalization"
        }
      }
    },
    "equivalence_forbidden": {
      "const": "A high response_crystallization metric does not prove the source symbolic crystallization profile."
    }
  }
}