{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/observation-runtime/v0.1/session-export.schema.json",
  "title": "AEON D.1 SESSION_EXPORT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_schema_version",
    "export_id",
    "exported_at",
    "runtime",
    "session",
    "response_series",
    "journal",
    "artifact_snapshots",
    "manifest"
  ],
  "properties": {
    "export_schema_version": {
      "const": "0.1-draft"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "runtime_version"
      ],
      "properties": {
        "runtime_id": {
          "const": "aeon-observation-runtime"
        },
        "runtime_version": {
          "const": "0.1"
        }
      }
    },
    "session": {
      "$ref": "https://ars-caeli.local/contracts/observation-runtime/v0.1/session-state.schema.json"
    },
    "response_series": {
      "$ref": "https://ars-caeli.local/contracts/v0.2/response-series.schema.json"
    },
    "journal": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "https://ars-caeli.local/contracts/observation-runtime/v0.1/runtime-event.schema.json"
      }
    },
    "artifact_snapshots": {
      "type": "array",
      "items": {
        "$ref": "https://ars-caeli.local/contracts/observation-runtime/v0.1/artifact-snapshot.schema.json"
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "canonicalization",
        "session_sha256",
        "response_series_sha256",
        "journal_sha256",
        "artifact_snapshots_sha256",
        "security_boundary"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "RFC8785-JCS"
        },
        "session_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_series_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "journal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_snapshots_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "security_boundary": {
          "const": "Hashes provide tamper evidence for exported components; they are not signatures and do not authenticate the author."
        }
      }
    }
  }
}
