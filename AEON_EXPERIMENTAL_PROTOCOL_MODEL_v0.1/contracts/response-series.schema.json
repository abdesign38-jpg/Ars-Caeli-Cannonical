{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/response-series.schema.json",
  "title": "RESPONSE_SERIES",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "series_id",
    "session_id",
    "participant_id",
    "protocol_id",
    "started_at",
    "observations",
    "engine_records",
    "derived_metrics",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "series_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "protocol_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_s",
          "timing_point",
          "condition_id",
          "responses",
          "status"
        ],
        "properties": {
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "timing_point": {
            "type": "string"
          },
          "condition_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "responses": {
            "type": "object"
          },
          "status": {
            "const": "participant_reported"
          }
        }
      }
    },
    "engine_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_s",
          "condition_id",
          "signal",
          "signal_metrics",
          "status"
        ],
        "properties": {
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "condition_id": {
            "type": "string"
          },
          "signal": {
            "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/signal_identity"
          },
          "signal_metrics": {
            "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/engine_signal_metrics"
          },
          "void_metrics": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "const": "engine_measured"
          }
        }
      }
    },
    "derived_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "value",
          "unit",
          "status",
          "preconditions_met",
          "calculation",
          "interpretation"
        ],
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "derived_metric"
          },
          "preconditions_met": {
            "type": "boolean"
          },
          "calculation": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          }
        }
      }
    },
    "interpretation_boundary": {
      "const": "Derived response metrics characterize this observed series; they do not diagnose a wound, prove a symbolic crystallization, or establish signal causality."
    }
  }
}