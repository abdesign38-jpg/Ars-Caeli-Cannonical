{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/observation-runtime/v0.1/context-marker.schema.json",
  "title": "AEON D.1 CONTEXT_MARKER",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker_schema_version",
    "marker_id",
    "source",
    "kind",
    "label",
    "data",
    "note",
    "interpretation_policy",
    "projection_policy"
  ],
  "properties": {
    "marker_schema_version": {
      "const": "0.1-draft"
    },
    "marker_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "source": {
      "enum": [
        "participant",
        "operator",
        "runtime"
      ]
    },
    "kind": {
      "enum": [
        "technical",
        "environmental",
        "phenomenological",
        "procedural",
        "unexpected"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {},
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "interpretation_policy": {
      "const": "none_at_capture"
    },
    "projection_policy": {
      "const": "journal_only"
    }
  }
}
