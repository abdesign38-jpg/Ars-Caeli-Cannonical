{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/observation-probe.schema.json",
  "title": "OBSERVATION_PROBE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_set_id",
    "design_rules",
    "primary_outcome",
    "items",
    "timing_points",
    "reveal_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "probe_set_id": {
      "type": "string"
    },
    "design_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutral_language",
        "no_wound_label_in_prompt",
        "no_body_prediction_in_prompt",
        "same_scale_across_conditions"
      ],
      "properties": {
        "neutral_language": {
          "const": true
        },
        "no_wound_label_in_prompt": {
          "const": true
        },
        "no_body_prediction_in_prompt": {
          "const": true
        },
        "same_scale_across_conditions": {
          "const": true
        }
      }
    },
    "primary_outcome": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "response_type",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "response_type": {
            "type": "string",
            "enum": [
              "rating",
              "bipolar_rating",
              "single_choice",
              "multi_choice",
              "free_text",
              "duration_estimate_s",
              "body_map_free"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "context",
              "qualitative"
            ]
          },
          "scale": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "min_label": {
                "type": "string"
              },
              "max_label": {
                "type": "string"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "status": {
            "const": "experimental_operationalization"
          },
          "source_derivation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "timing_points": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "baseline",
          "after_each_block",
          "immediate_post",
          "recovery_60s",
          "recovery_180s"
        ]
      }
    },
    "reveal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_expectation_hidden_until",
        "participant_can_skip"
      ],
      "properties": {
        "model_expectation_hidden_until": {
          "type": "string"
        },
        "participant_can_skip": {
          "const": true
        }
      }
    }
  }
}