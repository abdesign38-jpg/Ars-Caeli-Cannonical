{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/executable-protocol.schema.json",
  "title": "EXECUTABLE_EXPERIMENT_PROTOCOL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_status",
    "compiler_version",
    "protocol_id",
    "source_sha256",
    "primary_outcome",
    "controlled_signal",
    "runtime_policy",
    "probe_set_ref",
    "condition_sequence",
    "condition_fingerprints",
    "integrity"
  ],
  "properties": {
    "execution_status": {
      "const": "validated"
    },
    "compiler_version": {
      "const": "0.1"
    },
    "protocol_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "primary_outcome": {
      "type": "object"
    },
    "controlled_signal": {
      "$ref": "https://ars-caeli.local/contracts/common.schema.json#/$defs/signal_identity"
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_clock",
        "cycle_reset",
        "pause",
        "between_conditions",
        "baseline",
        "post_exposure",
        "recovery",
        "manual_controls",
        "integrity_breach_policy"
      ],
      "properties": {
        "condition_clock": { "const": "active_exposure_only" },
        "cycle_reset": { "const": "at_each_condition_start" },
        "pause": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "clock_behavior", "audio_behavior", "resume_behavior", "record_pause_duration"],
          "properties": {
            "allowed": { "const": true },
            "clock_behavior": { "const": "freeze_condition_clock" },
            "audio_behavior": { "const": "silence" },
            "resume_behavior": { "const": "continue_same_condition_time" },
            "record_pause_duration": { "const": true }
          }
        },
        "between_conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audio_state", "next_condition_trigger", "gap_duration_policy"],
          "properties": {
            "audio_state": { "const": "silence" },
            "next_condition_trigger": { "const": "required_probe_saved_or_skipped" },
            "gap_duration_policy": { "const": "participant_contingent_record_actual" }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_trigger", "audio_state"],
          "properties": {
            "probe_trigger": { "const": "before_first_condition" },
            "audio_state": { "const": "silence" }
          }
        },
        "post_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audio_state", "immediate_post_trigger"],
          "properties": {
            "audio_state": { "const": "silence" },
            "immediate_post_trigger": { "const": "final_condition_end" }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audio_state", "clock_anchor", "probe_offsets_s"],
          "properties": {
            "audio_state": { "const": "silence" },
            "clock_anchor": { "const": "final_condition_end" },
            "probe_offsets_s": { "const": [60, 180] }
          }
        },
        "manual_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carrier", "modulation", "void_schedule", "gate_envelope", "aeon_master_gain"],
          "properties": {
            "carrier": { "const": "locked" },
            "modulation": { "const": "locked" },
            "void_schedule": { "const": "locked" },
            "gate_envelope": { "const": "locked" },
            "aeon_master_gain": { "const": "locked_at_protocol_start" }
          }
        },
        "integrity_breach_policy": { "const": "abort_condition_and_mark_series_invalid" }
      }
    },
    "probe_set_ref": {
      "type": "string"
    },
    "condition_sequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "condition_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validation",
        "semantic_validation",
        "reference_validation",
        "conditions_compiled"
      ],
      "properties": {
        "schema_validation": {
          "const": true
        },
        "semantic_validation": {
          "const": true
        },
        "reference_validation": {
          "const": true
        },
        "conditions_compiled": {
          "const": true
        }
      }
    }
  }
}