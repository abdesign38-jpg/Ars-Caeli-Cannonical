{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-caeli.local/contracts/observation-runtime/v0.1/runtime-event.schema.json",
  "title": "AEON D.1 RUNTIME_EVENT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_schema_version",
    "event_id",
    "session_id",
    "seq",
    "event_type",
    "wall_time",
    "runtime_epoch_id",
    "performance_time_origin_ms",
    "monotonic_ms",
    "attempt_id",
    "payload"
  ],
  "properties": {
    "event_schema_version": {
      "const": "0.1-draft"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "enum": [
        "session_created",
        "session_started",
        "trial_armed",
        "stimulus_onset",
        "response_captured",
        "response_timeout",
        "attempt_aborted",
        "integrity_flagged",
        "behavioral_record_committed",
        "participant_observation_committed",
        "context_marker_recorded",
        "recovery_detected",
        "session_finalized",
        "session_aborted"
      ]
    },
    "wall_time": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_epoch_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "performance_time_origin_ms": {
      "type": "number",
      "minimum": 0
    },
    "monotonic_ms": {
      "type": "number",
      "minimum": 0
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_type": {
          "enum": [
            "perceptual_stimulus",
            "behavioral_probe",
            "behavioral_trial"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "display_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "device_pixel_ratio"
      ],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "device_pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "refresh_hz_estimate": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {
              "const": "session_created"
            },
            "attempt_id": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "series_id",
                "participant_id",
                "protocol_id",
                "created_at",
                "runtime_id",
                "runtime_version",
                "interpretation_policy"
              ],
              "properties": {
                "series_id": {
                  "type": "string",
                  "minLength": 1
                },
                "participant_id": {
                  "type": "string",
                  "minLength": 1
                },
                "protocol_id": {
                  "type": "string",
                  "minLength": 1
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "runtime_id": {
                  "const": "aeon-observation-runtime"
                },
                "runtime_version": {
                  "const": "0.1"
                },
                "interpretation_policy": {
                  "const": "no_automatic_interpretation"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "session_started"
            },
            "attempt_id": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "started_at"
              ],
              "properties": {
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "trial_armed"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_ordinal",
                "timing_point",
                "probe_ref",
                "trial_ref",
                "stimulus_refs"
              ],
              "properties": {
                "attempt_ordinal": {
                  "type": "integer",
                  "minimum": 1
                },
                "timing_point": {
                  "enum": [
                    "calibration",
                    "standalone",
                    "pre_protocol_behavioral",
                    "post_recovery_behavioral"
                  ]
                },
                "probe_ref": {
                  "$ref": "#/$defs/artifact_ref"
                },
                "trial_ref": {
                  "$ref": "#/$defs/artifact_ref"
                },
                "stimulus_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/artifact_ref"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "stimulus_onset"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "presentation_source",
                "display_context"
              ],
              "properties": {
                "presentation_source": {
                  "enum": [
                    "runtime_call",
                    "presentation_adapter"
                  ]
                },
                "display_context": {
                  "$ref": "#/$defs/display_context"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "response_captured"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "choice_id",
                "input_modality"
              ],
              "properties": {
                "choice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "input_modality": {
                  "enum": [
                    "keyboard",
                    "pointer",
                    "touch",
                    "other"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "response_timeout"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "const": "response_window_elapsed"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "attempt_aborted"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "integrity_flagged"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "status",
                "reason"
              ],
              "properties": {
                "dimension": {
                  "enum": [
                    "perceptual_stimulus_integrity",
                    "response_input_integrity",
                    "timing_integrity"
                  ]
                },
                "status": {
                  "enum": [
                    "INVALID",
                    "UNKNOWN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "behavioral_record_committed"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record"
              ],
              "properties": {
                "record": {
                  "$ref": "https://ars-caeli.local/contracts/v0.2/behavioral-record.schema.json"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "participant_observation_committed"
            },
            "attempt_id": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observation"
              ],
              "properties": {
                "observation": {
                  "$ref": "https://ars-caeli.local/contracts/response-series.schema.json#/properties/observations/items"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "context_marker_recorded"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "marker"
              ],
              "properties": {
                "marker": {
                  "$ref": "https://ars-caeli.local/contracts/observation-runtime/v0.1/context-marker.schema.json"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "recovery_detected"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prior_state",
                "prior_runtime_epoch_id",
                "new_runtime_epoch_id",
                "disposition"
              ],
              "properties": {
                "prior_state": {
                  "enum": [
                    "ARMED",
                    "OBSERVING",
                    "RESOLVED"
                  ]
                },
                "prior_runtime_epoch_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "new_runtime_epoch_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "disposition": {
                  "enum": [
                    "reconstruct_commit",
                    "abort_and_commit"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "session_finalized"
            },
            "attempt_id": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "response_series_sha256"
              ],
              "properties": {
                "response_series_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "session_aborted"
            },
            "attempt_id": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  ]
}
